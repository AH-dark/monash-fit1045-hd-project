# gRPC-Web Envoy gateway URL (see deploy/docker-compose.dev.yml)
VITE_GRPC_WEB_URL=http://localhost:8080
# Heartbeat interval (milliseconds). Must be well under server --heartbeat-sweep-interval (default 5s)
VITE_HEARTBEAT_INTERVAL_MS=3000
# Page size for cursor-paginated channel history (1..200, server-side cap is 200)
VITE_CHANNEL_HISTORY_PAGE_SIZE=50
