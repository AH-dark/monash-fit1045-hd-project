{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "conan:install",
      "type": "shell",
      "command": "conan",
      "args": [
        "install", ".",
        "--profile=conan_profiles/${input:profile}",
        "--build=missing",
        "-of=build/debug",
        "-s", "build_type=Debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "cmake:configure:debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "dependsOn": ["conan:install"],
      "problemMatcher": []
    },
    {
      "label": "build:debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build:release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "test:debug",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "debug", "--output-on-failure"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "format",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/format.sh"],
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/lint.sh"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "profile",
      "type": "pickString",
      "description": "Conan profile to use",
      "options": ["dev-macos", "dev-linux", "release-linux", "ci"],
      "default": "dev-macos"
    }
  ]
}
