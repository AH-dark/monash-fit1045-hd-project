# Build outputs
build/
build-*/

# Node modules (clinet-web has its own .dockerignore)
**/node_modules/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Sisyphus state
.sisyphus/

# Git
.git/
.gitignore
.github/

# Documentation (not needed for build, except README which we keep small)
*.md
!proto/**/*.md

# Tooling caches
.clangd/
.cache/
__pycache__/
*.pyc
.ruff_cache/

# Test outputs
coverage/
*.log

# Client-web (will use its own Dockerfile + context)
client-web/node_modules/
client-web/.output/
client-web/.tanstack/
client-web/test-results/
client-web/playwright-report/

# OS
Thumbs.db

# Conan workspace
conan.lock

# Generated outputs not needed for server build
deploy/
docker-compose*.yml
Dockerfile*
.dockerignore
